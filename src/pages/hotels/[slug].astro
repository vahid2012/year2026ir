---
import '@/styles/globals.css';
import Layout from '@/layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { HOTELS, TOURS, SITE, LINKS } from '@/lib/site';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';

export async function getStaticPaths() {
  const hotels = await getCollection('hotels');
  return hotels.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'hotels'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const meta = HOTELS.find((h) => h.slug === entry.slug);

const hotelLd = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  name: d.title,
  description: d.description,
  url: `${SITE.domain}/hotels/${entry.slug}`,
  image: d.image,
  starRating: { '@type': 'Rating', ratingValue: d.starRating },
  address: { '@type': 'PostalAddress', streetAddress: d.address, addressLocality: 'Yerevan', addressCountry: 'AM' },
  priceRange: d.priceUSD,
  amenityFeature: d.amenities.map((a) => ({ '@type': 'LocationFeatureSpecification', name: a })),
};

const breadLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'خانه', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'هتل‌ها', item: `${SITE.domain}/hotels` },
    { '@type': 'ListItem', position: 3, name: d.title, item: `${SITE.domain}/hotels/${entry.slug}` },
  ],
};
---

<Layout
  title={`${d.title} | هتل‌های ایروان`}
  description={d.description}
  canonical={`/hotels/${entry.slug}`}
  image={d.image}
  type="article"
  jsonLd={[hotelLd, breadLd]}
>
  <Breadcrumbs items={[{ name: 'خانه', path: '/' }, { name: 'هتل‌ها', path: '/hotels' }, { name: d.title }]} />

  <article>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0">
        <img src={d.image} alt={d.imageAlt} width="940" height="650" class="h-full w-full object-cover" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-t from-secondary/95 via-secondary/70 to-secondary/30"></div>
      </div>
      <div class="relative container-fa py-20 md:py-28 text-white">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="rounded-full bg-primary px-3 py-1 text-sm font-bold">{d.starRating} ستاره</span>
          <span class="rounded-full bg-white/20 px-3 py-1 text-sm">{d.district}</span>
          <span class="rounded-full bg-white/20 px-3 py-1 text-sm">{d.priceUSD}</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold mb-4 max-w-3xl">{d.title}</h1>
        <p class="text-lg text-white/90 max-w-2xl leading-8">{d.excerpt}</p>
      </div>
    </section>

    <!-- Quick CTA bar -->
    <section class="border-b border-border bg-card">
      <div class="container-fa py-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="font-bold text-primary">{d.priceUSD}</span>
          <span class="text-sm text-muted-foreground">{d.priceAMD}</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={LINKS.whatsapp} target="_blank" rel="noopener" class="btn-primary-fa !py-2 !px-4 text-xs">رزرو در واتساپ</a>
          <a href={LINKS.telegram} target="_blank" rel="noopener" class="btn-secondary-fa !py-2 !px-4 text-xs">تلگرام</a>
          <a href={LINKS.phoneCall} class="btn-secondary-fa !py-2 !px-4 text-xs" dir="ltr">{SITE.phone}</a>
        </div>
      </div>
    </section>

    <!-- Body + sidebar -->
    <div class="container-fa py-10 grid gap-10 lg:grid-cols-[1fr_300px]">
      <div class="prose-fa max-w-none">
        <Content />

        <!-- Gallery -->
        <section class="my-10">
          <h2 class="section-title mb-5">گالری تصاویر</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {d.gallery.map((g) => (
              <img src={g.src} alt={g.alt} width="940" height="650" loading="lazy" decoding="async" class="rounded-xl w-full h-48 object-cover" />
            ))}
          </div>
        </section>

        <!-- Pros and Cons -->
        <section class="my-10 grid gap-6 sm:grid-cols-2">
          <div class="card-fa p-6">
            <h3 class="font-bold text-lg mb-4 text-success">نقاط قوت</h3>
            <ul class="space-y-2 text-sm text-muted-foreground">
              {d.pros.map((p) => (
                <li class="flex items-start gap-2">
                  <span class="text-success mt-1">✓</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="card-fa p-6">
            <h3 class="font-bold text-lg mb-4 text-warning">نقاط ضعف</h3>
            <ul class="space-y-2 text-sm text-muted-foreground">
              {d.cons.map((c) => (
                <li class="flex items-start gap-2">
                  <span class="text-warning mt-1">!</span>
                  <span>{c}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div class="card-fa p-5">
          <h3 class="font-bold mb-3">جزئیات هتل</h3>
          <ul class="text-sm space-y-2 text-muted-foreground">
            <li>ستاره: <span class="text-foreground font-semibold">{d.starRating} ستاره</span></li>
            <li>منطقه: <span class="text-foreground font-semibold">{d.district}</span></li>
            <li>آدرس: <span class="text-foreground font-semibold">{d.address}</span></li>
            <li>تا میدان جمهوریه: <span class="text-foreground font-semibold">{d.distanceRepublicSquare}</span></li>
            <li>تا کاسکید: <span class="text-foreground font-semibold">{d.distanceCascade}</span></li>
            <li>قیمت: <span class="text-primary font-bold">{d.priceUSD}</span></li>
          </ul>
          <a href={LINKS.whatsapp} target="_blank" rel="noopener" class="btn-primary-fa w-full mt-4">رزرو هتل در واتساپ</a>
        </div>

        <div class="card-fa p-5">
          <h3 class="font-bold mb-3">امکانات</h3>
          <ul class="text-sm space-y-2 text-muted-foreground">
            {d.amenities.map((a) => (
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>{a}</span>
              </li>
            ))}
          </ul>
        </div>

        {meta && d.relatedTours.length > 0 && (
          <div class="card-fa p-5">
            <h3 class="font-bold mb-3">تورهای مرتبط</h3>
            <ul class="text-sm space-y-2">
              {d.relatedTours.map((slug) => {
                const t = TOURS.find((x) => x.slug === slug);
                return t && <li><a href={`/tours/${t.slug}`} class="link-fa">{t.shortTitle}</a></li>;
              })}
              <li><a href="/contact" class="link-fa">تماس با ما</a></li>
            </ul>
          </div>
        )}

        <div class="card-fa p-5">
          <h3 class="font-bold mb-3">سایر هتل‌ها</h3>
          <ul class="text-sm space-y-2">
            {HOTELS.filter((h) => h.slug !== entry.slug).map((h) => (
              <li><a href={`/hotels/${h.slug}`} class="link-fa">{h.shortTitle}</a></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    <!-- FAQ -->
    <Faq faqs={d.faqs} pageUrl={`/hotels/${entry.slug}`} />
  </article>

  <Cta compact />
</Layout>
