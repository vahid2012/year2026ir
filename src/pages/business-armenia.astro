---
import '@/styles/globals.css';
import Layout from '@/layouts/Layout.astro';
import { SITE, LINKS } from '@/lib/site';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';

const faqs = [
  {
    q: 'آیا شهروندان ایرانی می‌توانند در ارمنستان شرکت ثبت کنند؟',
    a: 'بله. شهروندان ایرانی می‌توانند با پاسپورت معتبر و مدارک هویتی در ارمنستان شرکت ثبت کنند. فرآیند ثبت شرکت در ارمنستان برای اتباع خارجی ساده است و نیاز به اقامت دائم ندارد. پس از ثبت، شرکت می‌تواند حساب بانکی باز کند، ملک بخرد و فعالیت تجاری انجام دهد. آکای تراول می‌تواند شما را به وکلای متخصص در ارمنستان وصل کند.',
  },
  {
    q: 'مالیات بر ارزش افزوده در ارمنستان چقدر است؟',
    a: 'مالیات بر ارزش افزوده (VAT) در ارمنستان ۲۰ درصد است که بر اکثر کالاها و خدمات اعمال می‌شود. شرکت‌هایی که گردش مالی سالانه آن‌ها از ۱۱۵ میلیون درام (حدود ۲۹۰ هزار دلار) بیشتر باشد، ملزم به ثبت‌نام مالیات VAT هستند. شرکت‌های کوچک‌تر می‌توانند از مالیات گردشی ۵ درصد استفاده کنند.',
  },
  {
    q: 'بهترین روش انتقال پول از ایران به ارمنستان چیست؟',
    a: 'از آنجا که کارت‌های بانکی ایرانی در ارمنستان کار نمی‌کنند، بهترین روش‌ها شامل: حمل نقدی دلار یا درام (تا سقف ۱۰ هزار یورو بدون اظهار)، استفاده از صرافی‌های بین‌المللی، یا افتتاح حساب بانکی در ارمنستان با پاسپورت می‌باشد. بانک‌های ارمنستان مانند اچ‌اس‌بی‌سی و وتسی بانک خدمات ویژه برای تجار خارجی دارند.',
  },
  {
    q: 'آیا ارمنستان عضو اتحادیه اقتصادی اوراسیا (EAEU) است؟',
    a: 'بله، ارمنستان از سال ۲۰۱۵ عضو اتحادیه اقتصادی اوراسیا (EAEU) است. این اتحادیه شامل روسیه، بلاروس، قزاقستان، قرقیزستان و ارمنستان می‌شود و بازار مشترکی با بیش از ۱۸۰ میلیون مصرف‌کننده ایجاد می‌کند. عضویت در EAEU به شرکت‌های ثبت‌شده در ارمنستان امکان صادرات بدون تعرفه به سایر کشورهای عضو را می‌دهد.',
  },
  {
    q: 'هزینه ثبت شرکت در ارمنستان چقدر است؟',
    a: 'هزینه ثبت شرکت مسئولیت محدود (LLC) در ارمنستان حدود ۴۰ تا ۱۰۰ هزار درام (۱۰۰ تا ۲۵۰ دلار) برای هزینه‌های دولتی است. هزینه‌های وکیل و مشاور حقوقی بین ۳۰۰ تا ۸۰۰ دلار متغیر است. کل هزینه ثبت شرکت با کمک مشاور حدود ۵۰۰ تا ۱۲۰۰ دلار است و فرآیند ثبت معمولاً ۳ تا ۷ روز کاری طول می‌کشد.',
  },
];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'راهنمای تجارت با ارمنستان',
  description: 'راهنمای کامل تجارت با ارمنستان؛ ثبت شرکت، مالیات، بانکداری، واردات و صادرات، کریدورهای تجاری ایران و ارمنستان.',
  url: `${SITE.domain}/business-armenia`,
  inLanguage: 'fa-IR',
  author: { '@type': 'Organization', name: SITE.legalName, url: SITE.domain },
  publisher: { '@type': 'Organization', name: SITE.legalName, url: SITE.domain },
  image: 'https://images.pexels.com/photos/33175650/pexels-photo-33175650.jpeg?auto=compress&cs=tinysrgb&h=650&w=940',
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: `${SITE.domain}/business-armenia`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="راهنمای تجارت با ارمنستان | آکای تراول"
  description="راهنمای کامل تجارت با ارمنستان؛ ثبت شرکت، مالیات VAT ۲۰٪، بانکداری، واردات و صادرات، کریدورهای تجاری ایران و ارمنستان و نکات کاربردی."
  canonical="/business-armenia"
  image="https://images.pexels.com/photos/33175650/pexels-photo-33175650.jpeg?auto=compress&cs=tinysrgb&h=650&w=940"
  type="article"
  jsonLd={[articleLd, faqLd]}
>
  <Breadcrumbs items={[{ name: 'خانه', path: '/' }, { name: 'تجارت با ارمنستان' }]} />

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img src="https://images.pexels.com/photos/33175650/pexels-photo-33175650.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="دست‌دهی تجاری نماد همکاری ایران و ارمنستان" width="940" height="650" class="h-full w-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-secondary/95 via-secondary/70 to-secondary/30"></div>
    </div>
    <div class="relative container-fa py-20 md:py-28 text-white">
      <h1 class="text-3xl md:text-5xl font-extrabold mb-4 max-w-3xl">راهنمای تجارت با ارمنستان</h1>
      <p class="text-lg text-white/90 max-w-2xl leading-8">
        راهنمای کامل کسب‌وکار در ارمنستان؛ از ثبت شرکت و مالیات تا بانکداری، واردات و صادرات و کریدورهای تجاری ایران و ارمنستان.
      </p>
    </div>
  </section>

  <section class="container-fa py-10">
    <div class="prose-fa max-w-none text-muted-foreground leading-8">
      <p>
        ارمنستان یکی از مهم‌ترین دروازه‌های تجاری ایران به منطقه قفقاز و اتحادیه اقتصادی اوراسیا است. با موقعیت استراتژیک، مالیات معقول، فرآیند ساده ثبت شرکت و عضویت در اتحادیه اقتصادی اوراسیا، ارمنستان فرصت‌های بی‌نظیری برای تجار ایرانی فراهم می‌کند. در این راهنما، همه‌چیز که برای شروع تجارت با ارمنستان باید بدانید را با جزئیات کامل توضیح می‌دهیم؛ از دلایل انتخاب ارمنستان تا ثبت شرکت، مالیات، بانکداری، واردات و صادرات و کریدورهای تجاری. آکای تراول علاوه بر تورهای گردشگری، به تجار ایرانی در سفرهای تجاری به ارمنستان نیز خدمات ارائه می‌دهد.
      </p>

      <h2 class="section-title mb-4 mt-10">چرا ارمنستان برای تجارت؟</h2>
      <p>
        ارمنستان با جمعیت حدود ۳ میلیون نفر در خود و دسترسی به بازار ۱۸۰ میلیونی اتحادیه اقتصادی اوراسیا، مقصد جذابی برای تجار ایرانی است. این کشور دارای مالیات شرکتی پایین (۱۸ درصد)، فرآیند ثبت شرکت سریع (۳ تا ۷ روز) و قوانین سرمایه‌گذاری خارجی شفاف است. عضویت ارمنستان در اتحادیه اقتصادی اوراسیا (EAEU) از سال ۲۰۱۵ به شرکت‌های ثبت‌شده در ارمنستان امکان صادرات بدون تعرفه به روسیه، بلاروس، قزاقستان و قرقیزستان را می‌دهد. این مزیت رقابتی، ارمنستان را به پلی برای دسترسی ایرانیان به بازارهای اوراسیا تبدیل کرده است.
      </p>
      <p>
        علاوه بر این، ارمنستان با ایران مرز زمینی مشترک دارد و کریدور تجاری نوردوز-مغری بزرگ‌ترین مسیر مبادلات تجاری بین دو کشور است. روابط سیاسی دو کشور دوستانه است و شهروندان ایرانی می‌توانند بدون ویزا و با کارت ملی یا پاسپورت وارد ارمنستان شوند. این سهولت دسترسی، سفرهای تجاری را بسیار آسان می‌کند. برای آشنایی بیشتر با آکای تراول و خدمات ما، [درباره ما](/about) را بخوانید.
      </p>

      <div class="my-8 rounded-2xl overflow-hidden shadow-xl">
        <img src="https://images.pexels.com/photos/7792841/pexels-photo-7792841.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="جلسه تجاری در دفتر کار بین تجار ایرانی و ارمنی" width="940" height="650" class="w-full h-64 object-cover" loading="lazy" />
      </div>

      <h2 class="section-title mb-4 mt-10">ثبت شرکت در ارمنستان</h2>
      <p>
        ثبت شرکت در ارمنستان برای اتباع خارجی ساده و سریع است. رایج‌ترین نوع شرکت، شرکت مسئولیت محدود (LLC) است که حداقل یک شریک نیاز دارد و سرمایه ثبت لازم ندارد. فرآیند ثبت شامل مراحل زیر است: انتخاب نام شرکت، تهیه اسناد ثبت (با کمک وکیل محلی)، ارائه پاسپورت ترجمه‌شده، ثبت در دفتر ثبت دولتی (State Register)، دریافت شناسه مالیاتی و افتتاح حساب بانکی. کل فرآیند معمولاً ۳ تا ۷ روز کاری طول می‌کشد و هزینه کل با کمک مشاور حدود ۵۰۰ تا ۱۲۰۰ دلار است.
      </p>
      <p>
        پس از ثبت شرکت، باید شناسه مالیاتی دریافت کنید و در صورت نیاز، ثبت‌نام مالیات بر ارزش افزوده (VAT) انجام دهید. شرکت‌های ثبت‌شده می‌توانند ملک بخرند، حساب بانکی باز کنند، نیروی کار استخدام کنند و فعالیت تجاری کامل انجام دهند. برای تجار ایرانی، توصیه می‌شود ثبت شرکت را با کمک وکیل متخصص و مشاور مالی انجام دهید تا از خطاهای حقوقی جلوگیری شود. آکای تراول می‌تواند شما را به وکلای متخصص و مشاوران مالی مورد اعتماد در ایروان وصل کند.
      </p>

      <h2 class="section-title mb-4 mt-10">مالیات در ارمنستان</h2>
      <p>
        سیستم مالیاتی ارمنستان یکی از ساده‌ترین سیستم‌های مالیاتی در منطقه است. سه نوع اصلی مالیات برای شرکت‌ها وجود دارد. <strong>مالیات بر ارزش افزوده (VAT)</strong> با نرخ ۲۰ درصد بر اکثر کالاها و خدمات اعمال می‌شود. شرکت‌هایی که گردش مالی سالانه آن‌ها از ۱۱۵ میلیون درام (حدود ۲۹۰ هزار دلار) بیشتر باشد، ملزم به ثبت‌نام VAT هستند. <strong>مالیات سود شرکت</strong> با نرخ ۱۸ درصد بر سود خالص شرکت اعمال می‌شود. <strong>مالیات گردشی (Turnover Tax)</strong> با نرخ ۵ درصد برای شرکت‌های کوچک که از ثبت VAT معاف هستند، جایگزین VAT می‌شود.
      </p>
      <p>
        علاوه بر این، مالیات بر درآمد شخصی با نرخ ۲۳ درصد (پلکانی ۲۳ تا ۳۶ درصد) و مالیات بیمه اجتماعی ۵ درصد بر حقوق کارمندان اعمال می‌شود. شرکت‌های فعال در حوزه فناوری اطلاعات می‌توانند از طرح «IT Transparency» استفاده کنند که مالیات سود را تا ۵ درصد کاهش می‌دهد. درک کامل سیستم مالیاتی برای تجار ایرانی ضروری است و توصیه می‌شود با یک حسابدار ارمنی همکاری کنید.
      </p>

      <div class="my-8 rounded-2xl overflow-hidden shadow-xl">
        <img src="https://images.pexels.com/photos/8112160/pexels-photo-8112160.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="جلسه تجاری در دفتر مدرن ایروان" width="940" height="650" class="w-full h-64 object-cover" loading="lazy" />
      </div>

      <h2 class="section-title mb-4 mt-10">بانکداری در ارمنستان</h2>
      <p>
        سیستم بانکی ارمنستان مدرن و پایدار است. افتتاح حساب بانکی برای شرکت‌های ثبت‌شده ساده است و نیاز به اقامت دائم ندارد. بانک‌های اصلی ارمنستان شامل اچ‌اس‌بی‌سی (HSBC)، وتسی بانک (VTB Bank)، اچ‌اس‌بی‌سی ارمنستان، اکونومی‌بانک و اینکوبانک هستند. بانک اچ‌اس‌بی‌سی ارمنستان خدمات ویژه برای شرکت‌های بین‌المللی دارد و حساب‌های چند ارزی (دلار، یورو، درام، روبل) ارائه می‌دهد. برای افتتاح حساب، به اسناد ثبت شرکت، شناسه مالیاتی، پاسپورت مدیر و مدارک آدرس شرکت نیاز است.
      </p>
      <p>
        برای تجار ایرانی، یکی از چالش‌های اصلی انتقال پول از ایران به ارمنستان است. از آنجا که کارت‌های بانکی ایرانی در ارمنستان کار نمی‌کنند، روش‌های رایج شامل حمل نقدی (تا سقف ۱۰ هزار یورو بدون اظهار گمرکی)، استفاده از صرافی‌های بین‌المللی، یا انتقال از طریق حساب شرکت در ارمنستان می‌باشد. صرافی‌های ایروان نرخ مناسبی برای تبدیل دلار و یورو به درام ارائه می‌دهند. توصیه می‌شود برای مبالغ بزرگ، از خدمات بانکی حرفه‌ای استفاده کنید.
      </p>

      <h2 class="section-title mb-4 mt-10">واردات و صادرات و گمرک</h2>
      <p>
        ارمنستان با عضویت در اتحادیه اقتصادی اوراسیا، قوانین گمرکی مشترکی با سایر کشورهای عضو دارد. تعرفه‌های گمرکی برای واردات از خارج اتحادیه بین ۰ تا ۱۵ درصد متغیر است و برای واردات از کشورهای عضو EAEU تعرفه صفر اعمال می‌شود. این مزیت به شرکت‌های ثبت‌شده در ارمنستان امکان می‌دهد کالاهای وارداتی از ایران را پس از پرداخت تعرفه گمرکی ارمنستان، به سایر کشورهای EAEU بدون تعرفه اضافی صادر کنند.
      </p>
      <p>
        کالاهای اصلی صادراتی ایران به ارمنستان شامل مواد شیمیایی، محصولات پتروشیمی، خشکبار (زردآلو، گردو، پسته)، فرش ایرانی، مصالح ساختمانی و قطعات خودرو هستند. واردات از ارمنستان به ایران شامل کنیاک ارمنی، معدن (مس، مولیبدن)، ماشین‌آلات و محصولات کشاورزی است. برای آشنایی با فرهنگ ارمنستان و درک بهتر بازار محلی، شرکت در [تور مراسم خاص ارمنستان](/tours/special-ceremonies-armenia) می‌تواند دیدگاهی فرهنگی برای تجار فراهم کند. همچنین [تور ژانویه ایروان](/tours/january-armenia-yerevan) فرصتی برای سفر تجاری-تفریحی در فصل زمستان ارائه می‌دهد.
      </p>

      <div class="my-8 rounded-2xl overflow-hidden shadow-xl">
        <img src="https://images.pexels.com/photos/6918529/pexels-photo-6918529.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="توافق تجاری میان تجار در جلسه رسمی" width="940" height="650" class="w-full h-64 object-cover" loading="lazy" />
      </div>

      <h2 class="section-title mb-4 mt-10">کریدورهای تجاری ایران و ارمنستان</h2>
      <p>
        دو کریدور اصلی تجاری بین ایران و ارمنستان وجود دارد. <strong>کریدور نوردوز-مغری</strong> بزرگ‌ترین و مهم‌ترین مسیر تجاری زمینی است. نوردوز در سمت ارمنی و مغری در سمت ایرانی مرز مشترک دو کشور است. این مرز در تمام طول سال فعال است و کامیون‌های حمل بار روزانه از این مسور عبور می‌کنند. فاصله نوردوز تا ایروان حدود ۳۷۰ کیلومتر است و با کامیون تقریباً ۶ تا ۸ ساعت طول می‌کشد.
      </p>
      <p>
        <strong>مسیر هوایی</strong> دومین کریدور تجاری است. پروازهای مستقیم تهران-ایروان به صورت روزانه توسط ایرلاین‌هایی مانند ایران‌ایر و آرماویا انجام می‌شوند و پرواز تقریباً ۱ ساعت و ۳۰ دقیقه طول می‌کشد. برای سفرهای تجاری کوتاه، پرواز سریع‌ترین گزینه است. آکای تراول می‌تواند بلیت پرواز، هتل و برنامه گشت تجاری در ایروان را برای شما رزرو کند. برای رزرو سفر تجاری، از طریق [صفحه تماس](/contact) با ما در ارتباط باشید.
      </p>

      <h2 class="section-title mb-4 mt-10">حمل‌ونقل از نوردوز و مغری</h2>
      <p>
        حمل بار از نوردوز به ایروان با کامیون انجام می‌شود و هزینه حمل تقریباً ۲ تا ۴ دلار به ازای هر کیلومتر است. زمان حمل از نوردوز به ایروان حدود ۶ تا ۸ ساعت است. برای بارهای کوچک‌تر، خدمات حمل بار با مینی‌بوس و ون نیز در دسترس است. گمرک نوردوز در ساعات اداری فعال است و فرآیند ترخیص بسته به نوع بار ۲ تا ۲۴ ساعت طول می‌کشد. توصیه می‌شود قبل از ارسال بار، با یک ترخیص‌کار گمرکی در نوردوز هماهنگ کنید تا فرآیند تسریع شود.
      </p>
      <p>
        برای مسافران تجاری که از مرز زمینی عبور می‌کنند، تاکسی بین‌شهری از مغری به ایروان قابل دسترس است و حدود ۴ تا ۵ ساعت طول می‌کشد. هزینه تاکسی خصوصی حدود ۱۰۰ تا ۱۵۰ دلار است. آکای تراول می‌تواند ترانسفر خصوصی از مرز نوردوز به هتل در ایروان را برای شما رزرو کند. برای رزرو هتل در ایروان نیز می‌توانید از [صفحه هتل‌ها](/hotels) هتل مناسب سفر تجاری خود را انتخاب کنید.
      </p>

      <h2 class="section-title mb-4 mt-10">چالش‌های رایج و نکات کاربردی</h2>
      <p>
        تجارت با ارمنستان چالش‌هایی نیز دارد. اول، تفاوت زبان: زبان رسمی ارمنستان است و در امور تجاری، انگلیسی و روسی نیز استفاده می‌شود. داشتن مترجم یا همکار فارسی‌زبان در ایروان بسیار کمک‌کننده است. دوم، تفاوت‌های حقوقی: قوانین تجاری ارمنستان با ایران متفاوت است و توصیه می‌شود با وکیل محلی همکاری کنید. سوم، انتقال پول: به دلیل تحریم‌های بانکی ایران، انتقال پول مستقیم بین بانک‌های ایرانی و ارمنی محدود است و باید از روش‌های جایگزین استفاده کنید. چهارم، فرهنگ تجاری: ارمنی‌ها در تجارت رسمی و مستقیم هستند و روابط تجاری بر اعتماد و وفای به عهد استوار است.
      </p>
      <p>
        نکات کاربردی برای تجار ایرانی: پاسپورت با حداقل ۶ ماه اعتبار همراه داشته باشید. شناسه ملی شرکت و مدارک ثبت را ترجمه رسمی کنید. قبل از سفر، با وکیل یا مشاور تجاری در ایروان هماهنگ کنید. در جلسات تجاری لباس رسمی بپوشید. کارت ویزیت دو زبانه (فارسی-انگلیسی) همراه داشته باشید. برای اقامت طولانی‌تر، هتل‌های مرکز ایروان مانند [هتل ماریوت](/hotels/armenia-marriott-yerevan) یا [هتل دبل‌تری هیلتون](/hotels/doubletree-by-hilton-yerevan) مناسب هستند.
      </p>

      <h2 class="section-title mb-4 mt-10">چک‌لیست شروع تجارت با ارمنستان</h2>
      <ul class="list-disc pr-6 space-y-2">
        <li>پاسپورت معتبر با حداقل ۶ ماه اعتبار</li>
        <li>ترجمه رسمی مدارک شرکت و شناسه ملی</li>
        <li>همکاری با وکیل متخصص در ارمنستان</li>
        <li>ثبت شرکت مسئولیت محدود (LLC) در ایروان</li>
