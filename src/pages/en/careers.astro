---
import '@/styles/globals.css';
import { SITE, LINKS } from '@/lib/site';

const jobLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: 'Career Opportunities at Akay Travel',
  description: 'Akay Travel, a travel agency specializing in Armenia tours, is hiring. Tour guide, sales, content, and operations positions available.',
  url: `${SITE.domain}/en/careers`,
  employmentType: 'FULL_TIME',
  hiringOrganization: { '@type': 'Organization', name: SITE.brand, sameAs: SITE.domain },
};

const breadLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'Careers', item: `${SITE.domain}/en/careers` },
  ],
};

const alternates = [
  { hreflang: 'fa-IR', href: `${SITE.domain}/careers` },
  { hreflang: 'en', href: `${SITE.domain}/en/careers` },
  { hreflang: 'hy', href: `${SITE.domain}/hy/careers` },
  { hreflang: 'x-default', href: `${SITE.domain}/careers` },
];
---

<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>Careers | Akay Travel</title>
  <meta name="description" content="Career opportunities at Akay Travel; tour guide, sales, content creator, and operations roles. Requirements, benefits, and how to apply." />
  <link rel="canonical" href={`${SITE.domain}/en/careers`} />
  {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content={SITE.brand} />
  <meta property="og:title" content="Careers | Akay Travel" />
  <meta property="og:description" content="Career opportunities at Akay Travel; tour guide, sales, content, and operations." />
  <meta property="og:url" content={`${SITE.domain}/en/careers`} />
  <script type="application/ld+json" set:html={JSON.stringify(jobLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadLd)} />
</head>
<body class="min-h-screen flex flex-col bg-background text-foreground">
  <header class="sticky top-0 z-40 bg-background/85 backdrop-blur-md border-b border-border">
    <div class="container-fa flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center gap-2 font-extrabold text-lg md:text-xl">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-primary text-primary-foreground">A</span>
        <span class="text-secondary">Akay Travel</span>
      </a>
      <nav class="hidden md:flex items-center gap-1">
        <a href="/" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">Home</a>
        <a href="/tours" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">Tours</a>
        <a href="/hotels" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">Hotels</a>
        <a href="/travel-guide" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">Travel Guide</a>
        <a href="/en/careers" class="px-4 py-2 rounded-full text-sm font-semibold bg-primary text-primary-foreground">Careers</a>
        <a href="/contact" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">Contact</a>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <nav class="container-fa pt-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        <li class="flex items-center gap-2"><a href="/" class="hover:text-primary transition-colors">Home</a><span class="opacity-50">/</span></li>
        <li class="text-foreground font-semibold">Careers</li>
      </ol>
    </nav>

    <section class="relative overflow-hidden">
      <div class="absolute inset-0">
        <img src="https://images.pexels.com/photos/3184339/pexels-photo-3184339.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="Akay Travel team in a business meeting" width="940" height="650" class="h-full w-full object-cover" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-t from-secondary/95 via-secondary/70 to-secondary/30"></div>
      </div>
      <div class="relative container-fa py-20 md:py-28 text-white">
        <h1 class="text-3xl md:text-5xl font-extrabold mb-4 max-w-3xl">Careers at Akay Travel</h1>
        <p class="text-lg text-white/90 max-w-2xl leading-8">Join the Akay Travel team — a travel agency specializing in Armenia tours, looking for passionate and motivated people.</p>
      </div>
    </section>

    <section class="container-fa py-10">
      <div class="prose-fa max-w-none text-muted-foreground leading-8">
        <p>Akay Travel has been a specialist in Armenia event tours since 2018, growing with a small but motivated team. We are looking for people who are passionate about travel, Armenian culture, and serving Iranian travelers, and who want to work in a dynamic and creative environment. If you are looking for a job beyond the ordinary and would love to be part of an experience that brings Iranian travelers to the heart of Armenian culture, your place is waiting in our team.</p>

        <h2 class="section-title mb-4 mt-10">About Akay Travel</h2>
        <p>Akay Travel is a travel agency specializing in special event tours to Armenia. We have designed six special tours for Armenia's cultural and religious events: Christmas tour, January tour, Halloween tour, Balloon Festival tour, Vardavar tour, and Special Ceremonies tour. Our headquarters is in Urmia, Iran, and our team of experienced Armenia tour specialists is ready to answer travelers' questions and design the best travel itineraries. We work with a network of hotels, local guides, and transportation partners in Yerevan to create hassle-free and memorable trips for our travelers.</p>

        <h2 class="section-title mb-4 mt-10">Open Positions</h2>
        <p>We are currently seeking motivated individuals for the following positions:</p>

        <h3 class="font-bold text-lg mt-6 mb-2">Persilingual Tour Guide</h3>
        <p class="text-sm">The tour guide accompanies travelers on trips to Armenia, responsible for city tours, monastery visits, and attendance at cultural events. Fluency in Persian and Armenian or Russian, familiarity with Armenian culture and history, travel experience to Armenia, and group management skills are essential.</p>

        <h3 class="font-bold text-lg mt-6 mb-2">Sales and Reservation Specialist</h3>
        <p class="text-sm">The sales specialist is responsible for responding to customers on WhatsApp and Telegram, providing tour consultations, booking hotels and flights, and following up on the travel process. Strong communication skills, familiarity with reservation systems, sales ability, and experience in a travel agency or online sales are essential.</p>

        <h3 class="font-bold text-lg mt-6 mb-2">Content Creator</h3>
        <p class="text-sm">The content creator is responsible for writing travel guide articles, social media content, and tour descriptions. Strong writing skills in Persian, familiarity with SEO and social media, and a passion for travel and culture are essential.</p>

        <h3 class="font-bold text-lg mt-6 mb-2">Operations Specialist</h3>
        <p class="text-sm">The operations specialist is responsible for coordinating with hotels, transportation partners, and local guides in Yerevan, and following up on tour execution. Organizational skills, problem-solving ability, and familiarity with tourism processes are essential.</p>

        <h2 class="section-title mb-4 mt-10">Requirements</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li>Genuine interest in travel, Armenian culture, and customer service</li>
          <li>Ability to work in a team and communicate effectively</li>
          <li>Familiarity with English or Armenian for guide and operations positions</li>
          <li>Travel experience to Armenia for the tour guide position</li>
          <li>Proficiency with office software and social media</li>
          <li>Resident of Urmia or willing to relocate to Urmia</li>
        </ul>

        <h2 class="section-title mb-4 mt-10">Benefits</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li>Base salary plus sales commission</li>
          <li>Free travel to Armenia on special tours</li>
          <li>Dynamic and creative work environment</li>
          <li>Opportunities for growth and advancement in a growing company</li>
          <li>Flexible working hours</li>
          <li>Social security insurance</li>
        </ul>

        <h2 class="section-title mb-4 mt-10">How to Apply</h2>
        <p>To apply, send your resume via one of the following methods:</p>
        <div class="flex flex-wrap gap-3 my-4">
          <a href={LINKS.whatsapp} target="_blank" rel="noopener" class="btn-primary-fa">Send Resume on WhatsApp</a>
          <a href={LINKS.email} class="btn-secondary-fa">Email: sanat.abr@gmail.com</a>
        </div>
        <p>Please mention the position you are applying for in your message and send your resume or a brief description of your experience. We will contact you as soon as possible. To learn more about us, read our <a href="/about" class="link-fa">About page</a> and feel free to <a href="/contact" class="link-fa">contact us</a> directly.</p>

        <p class="mt-6">
          <a href="/careers" class="link-fa">فارسی</a> ·
          <a href="/hy/careers" class="link-fa">Հայերեն</a>
        </p>
      </div>
    </section>

    <section class="cta-fa my-8">
      <div class="container-fa">
        <div class="rounded-3xl bg-gradient-to-br from-primary to-accent text-primary-foreground px-6 py-10 text-center shadow-xl">
          <h2 class="text-2xl font-extrabold mb-3">Ready to join us?</h2>
          <p class="max-w-2xl mx-auto text-primary-foreground/90 mb-6">Contact Akay Travel today and start your journey with our team.</p>
          <a href={LINKS.whatsapp} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-white text-primary px-6 py-3 font-bold hover:scale-105 transition-transform shadow">Apply on WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-secondary text-secondary-foreground mt-16">
    <div class="container-fa py-6 text-xs text-secondary-foreground/70 flex flex-col md:flex-row items-center justify-between gap-2">
      <p>© {new Date().getFullYear()} {SITE.brand}. All rights reserved.</p>
      <p>Akay Travel — Armenia Tour Specialist</p>
    </div>
  </footer>

  <div class="fixed bottom-5 right-5 z-50 flex flex-col gap-3">
    <a href={LINKS.whatsapp} target="_blank" rel="noopener" aria-label="Chat on WhatsApp" class="group inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl transition-transform hover:scale-110">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
    </a>
  </div>
</body>
</html>
