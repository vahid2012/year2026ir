---
import '@/styles/globals.css';
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/lib/site';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';

const faqs = [
  { q: 'بهترین زمان بازدید از جاذبه‌های ایروان چیست؟', a: 'بهار (آوریل تا ژوئن) و پاییز (سپتامبر تا نوامبر) بهترین فصل‌ها هستند. هوا ملایم است و جاذبه‌ها خلوت‌تر. برای اطلاعات بیشتر [راهنمای بهترین زمان سفر](/blog/best-time-to-travel-armenia) را ببینید.' },
  { q: 'آیا ورودی موزه‌های ایروان گران است؟', a: 'خیر، ورودی موزه‌های ایروان بین ۱۰۰۰ تا ۳۰۰۰ درام (حدود ۱۰ تا ۳۰ هزار تومان) است. موزه تاریخ ایروان و گالری ملی ارمنستان از مهم‌ترین آن‌ها هستند.' },
  { q: 'فاصله دریاچه سوان تا ایروان چقدر است؟', a: 'دریاچه سوان در ۶۰ کیلومتری ایروان قرار دارد و با خودرو حدود ۱ ساعت طول می‌کشد. یک گشت یک‌روزه کامل برای بازدید از سوان و صومعه سواناوانک کافی است.' },
];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'جاذبه‌های گردشگری ایروان',
  description: 'راهنمای کامل جاذبه‌های ایروان؛ میدان جمهوریه، کاسکید، اپرا، ورنیساژ، اربونی، مادر ارمنستان و گشت یک‌روزه دریاچه سوان.',
  url: `${SITE.domain}/travel-guide/yerevan-attractions`,
  inLanguage: 'fa-IR',
  author: { '@type': 'Organization', name: SITE.legalName },
  publisher: { '@type': 'Organization', name: SITE.legalName },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: `${SITE.domain}/travel-guide/yerevan-attractions`,
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const breadLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'خانه', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'راهنمای سفر', item: `${SITE.domain}/travel-guide` },
    { '@type': 'ListItem', position: 3, name: 'جاذبه‌های ایروان', item: `${SITE.domain}/travel-guide/yerevan-attractions` },
  ],
};
---

<Layout
  title="جاذبه‌های گردشگری ایروان | راهنمای سفر"
  description="راهنمای کامل جاذبه‌های ایروان؛ میدان جمهوریه، کاسکید، اپرا، ورنیساژ، اربونی، مادر ارمنستان، موزه‌ها و گشت یک‌روزه دریاچه سوان."
  canonical="/travel-guide/yerevan-attractions"
  image="https://images.pexels.com/photos/15338719/pexels-photo-15338719.jpeg?auto=compress&cs=tinysrgb&h=650&w=940"
  type="article"
  jsonLd={[articleLd, faqLd, breadLd]}
>
  <Breadcrumbs items={[{ name: 'خانه', path: '/' }, { name: 'راهنمای سفر', path: '/travel-guide' }, { name: 'جاذبه‌های ایروان' }]} />

  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img src="https://images.pexels.com/photos/15338719/pexels-photo-15338719.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="کلیسای تاریخی ارمنستان با کوه آرارات در پس‌زمینه" width="940" height="650" class="h-full w-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-secondary/95 via-secondary/70 to-secondary/30"></div>
    </div>
    <div class="relative container-fa py-20 md:py-28 text-white">
      <h1 class="text-3xl md:text-5xl font-extrabold mb-4 max-w-3xl">جاذبه‌های گردشگری ایروان</h1>
      <p class="text-lg text-white/90 max-w-2xl leading-8">راهنمای کامل جاذبه‌های ایروان؛ از میدان جمهوریه و کاسکید تا موزه‌ها، ورنیساژ و گشت یک‌روزه دریاچه سوان.</p>
    </div>
  </section>

  <section class="container-fa py-10">
    <div class="prose-fa max-w-none text-muted-foreground leading-8">
      <p>ایروان، پایتخت ارمنستان، یکی از قدیمی‌ترین شهرهای جهان است که بیش از ۲۸۰۰ سال قدمت دارد. این شهر با ترکیبی از معماری باستانی، شوروی و مدرن، جاذبه‌های گردشگری بی‌شماری را در خود جای داده است. در این راهنما، مهم‌ترین جاذبه‌های ایروان را با جزئیات کامل معرفی می‌کنیم تا سفری آگاهانه داشته باشید. برای آشنایی با خیابان‌های ایروان نیز [راهنمای خیابان‌های معروف ایروان](/travel-guide/yerevan-streets) را بخوانید.</p>

      <h2 class="section-title mb-4 mt-10">میدان جمهوریه</h2>
      <p>میدان جمهوریه (Republic Square) قلب ایروان و یکی از زیباترین میدان‌های جهان است. این میدان با معماری نئوکلاسیک از سنگ توف صورتی ساخته شده و ساختمان‌های موزه تاریخ ایروان، وزارت خارجه و هتل ماریوت آن را احاطه کرده‌اند. فواره‌های رقصان میدان در شب‌ها با نورپردازی رنگی به نمایشی زیبا تبدیل می‌شوند. میدان در همه فصول فعال است اما در شب‌های تابستان بهترین تجربه را ارائه می‌دهد. برای اقامت در این منطقه، [هتل ماریوت ایروان](/hotels/armenia-marriott-yerevan) یا [هتل هالیدی‌این](/hotels/holiday-inn-yerevan-republic-square) پیشنهاد می‌شوند.</p>

      <div class="my-8 rounded-2xl overflow-hidden shadow-xl">
        <img src="https://images.pexels.com/photos/17958099/pexels-photo-17958099.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="میدان جمهوریه ایروان با فواره‌های رقصان" width="940" height="650" class="w-full h-64 object-cover" loading="lazy" />
      </div>

      <h2 class="section-title mb-4 mt-10">کاسکید ایروان</h2>
      <p>کاسکید (Cascade) یک مجموعه پلکانی عظیم از سنگ توف است که شهر قدیمی ایروان را به بخش شمالی متصل می‌کند. این بنای شگفت‌انگیز با ۵۷۲ پله، در بالای خود مجسمه‌های فضای باز از هنرمندان بین‌المللی را جای داده است. موزه هنر کافسجیان در داخل کاسکید قرار دارد و آثار هنری مدرن را نمایش می‌دهد. از بالای کاسکید، نمای پانورامای ایروان با کوه آرارات در افق بی‌نظیر است. کاسکید در همه ساعات روز باز است و ورودی رایگان است. برای اقامت نزدیک کاسکید، [هتل دبل‌تری هیلتون](/hotels/doubletree-by-hilton-yerevan) نزدیک‌ترین هتل زنجیره‌ای است.</p>

      <h2 class="section-title mb-4 mt-10">تئاتر اپرا و باله ایروان</h2>
      <p>تئاتر اپرا و باله آلکساندر اسپنداریان یکی از مهم‌ترین مراکز فرهنگی ایروان است. این ساختمان دایره‌ای شکل با معماری شوروی، در پارکی سرسبز قرار دارد و کنسرت‌ها، اپراها و باله‌ها در آن برگزار می‌شوند. بلیت کنسرت بین ۵۰۰۰ تا ۲۰۰۰۰ درام (۵۰ تا ۲۰۰ هزار تومان) است. در محوطه اپرا، کافه‌ها و بازارچه‌های دست‌ساز در روزهای آخر هفته برپا می‌شوند. در شب‌های [تور هالووین ایروان](/tours/halloween-armenia-yerevan)، محوطه اپرا یکی از مراکز اصلی رویدادهاست.</p>

      <div class="my-8 rounded-2xl overflow-hidden shadow-xl">
        <img src="https://images.pexels.com/photos/2096983/pexels-photo-2096983.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="خیابان‌های سرسبز ایروان در نزدیکی تئاتر اپرا" width="940" height="650" class="w-full h-64 object-cover" loading="lazy" />
      </div>

      <h2 class="section-title mb-4 mt-10">بازار ورنیساژ</h2>
      <p>ورنیساژ (Vernissage) بزرگ‌ترین بازار صنایع دستی ایروان است که در روزهای آخر هفته در فضای باز برپا می‌شود. در این بازار می‌توانید فرش ارمنی، زیورآلات نقره، صنایع چوبی، نقاشی‌ها و سوغاتی‌های ارمنی بخرید. چانه‌زنی در ورنیساژ مرسوم است و قیمت‌ها معمولاً ۲۰ تا ۳۰ درصد قابل کاهش هستند. بازار در روزهای شنبه و یکشنبه از ۱۰ صبح تا ۶ عصر فعال است. برای اقامت نزدیک ورنیساژ، [هتل توفنکیان](/hotels/tufenkian-historic-yerevan) در فاصله ۵ دقیقه پیاده‌روی قرار دارد.</p>

      <h2 class="section-title mb-4 mt-10">موزه اربونی (قلعه باستانی ایروان)</h2>
      <p>قلعه اربونی (Erebuni) در سال ۷۸۲ قبل از میلاد توسط پادشاه اورارتویی آرگیشتی اول ساخته شد و نام ایروان از همین قلعه گرفته شده است. این قلعه بر روی تپه‌ای مشرف به شهر قرار دارد و موزه اربونی در کنار آن، آثار باستانی کشف‌شده را نمایش می‌دهد. از بالای قلعه، نمای گسترده‌ای از ایروان قابل مشاهده است. موزه هر روز جز دوشنبه باز است و ورودی آن ۱۰۰۰ درام (حدود ۱۰ هزار تومان) است.</p>

      <div class="my-8 rounded-2xl overflow-hidden shadow-xl">
        <img src="https://images.pexels.com/photos/16206879/pexels-photo-16206879.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="نمای پانورامای ایروان با کوه آرارات" width="940" height="650" class="w-full h-64 object-cover" loading="lazy" />
      </div>

      <h2 class="section-title mb-4 mt-10">مادر ارمنستان (مادر آراتاتسین)</h2>
      <p>مجسمه مادر ارمنستان (Mother Armenia) در پارک پیروزی ایروان قرار دارد و نماد قدرت و مادریت ملت ارمنی است. این مجسمه ۲۲ متری از مس بر روی پایه‌ای ۳۰ متری نصب شده و از آن می‌توان نمای کامل ایروان را تماشا کرد. در پایه مجسمه، موزه جنگ قرار دارد که به جنگ قره‌باغ اختصاص دارد. پارک پیروزی با درختان بلند و مسیرهای پیاده‌روی، مکانی آرامش‌بخش برای استراحت است.</p>

      <h2 class="section-title mb-4 mt-10">موزه‌های ایروان</h2>
      <p>ایروان موزه‌های متعددی دارد که هر کدام جنبه‌ای از تاریخ و فرهنگ ارمنستان را نمایش می‌دهند. <strong>موزه تاریخ ارمنستان</strong> در میدان جمهوریه، از دوران پیش از تاریخ تا معاصر را پوشش می‌دهد. <strong>گالری ملی ارمنستان</strong> در کنار آن، بزرگ‌ترین مجموعه هنری ارمنی و اروپایی در کشور است. <strong>موزه نسل‌کشی ارمنی‌ها</strong> (Tsitsernakaberd) یادبود باشکوهی برای قربانیان نسل‌کشی ۱۹۱۵ است. <strong>موزه سرگئی پاراجانوف</strong> آثار این کارگردان مشهور را نمایش می‌دهد. همه موزه‌ها هر روز جز دوشنبه باز هستند.</p>

      <h2 class="section-title mb-4 mt-10">گشت یک‌روزه دریاچه سوان</h2>
      <p>دریاچه سوان (Lake Sevan) در ۶۰ کیلومتری شمال ایروان قرار دارد و یکی از بزرگ‌ترین دریاچه‌های کوهستانی جهان است. آب دریاچه آبی و شفاف است و در تابستان می‌توان در آن شنا کرد. صومعه سواناوانک بر فراز صخره‌ای مشرف به دریاچه قرار دارد و منظره‌ای بی‌نظیر می‌سازد. در مسیر بازگشت می‌توانید از صومعه آیراوانک و کلیسای ماتراوال نیز دیدن کنید. گشت یک‌روزه سوان با خودرو خصوصی یا تور آکای تراول قابل انجام است. برای مسافران [تور کریسمس ایروان](/tours/christmas-armenia-yerevan)، گشت سوان در برنامه تور قرار دارد.</p>

      <h2 class="section-title mb-4 mt-10">صومعه‌های اطراف ایروان</h2>
      <p>در شعاع ۵۰ کیلومتری ایروان، صومعه‌های تاریخی متعددی قرار دارند که بازدید از آن‌ها در یک گشت نیم‌روزه امکان‌پذیر است. <strong>صومعه گغارد</strong> که در صخره کنده شده و در فهرست میراث جهانی یونسکو قرار دارد، در ۴۰ کیلومتری ایروان است. <strong>معبد گارنی</strong> با معماری یونانی، در نزدیکی گغارد قرار دارد. <strong>صومعه کهچاریس</strong> در دامنه کوه تیغنیس، برای طبیعت‌گردی مناسب است. همه این صومعه‌ها در تورهای آکای تراول قابل بازدید هستند.</p>

      <h2 class="section-title mb-4 mt-10">بهترین زمان گشت در ایروان</h2>
      <p>بهار (آوریل تا ژوئن) و پاییز (سپتامبر تا نوامبر) بهترین فصل‌های گشت در ایروان هستند. هوا ملایم است (۱۵ تا ۲۵ درجه) و جاذبه‌ها خلوت‌تر. در تابستان (ژوئن تا اوت) هوا گرم است (تا ۳۵ درجه) اما شب‌های مطبوعی دارد. در زمستان (دسامبر تا فوریه) برف می‌بارد و برخی جاذبه‌های فضای باز کم‌دسترس‌تر می‌شوند، اما نورپردازی کریسمس شهر را زیبا می‌کند. برای اطلاعات فصلی بیشتر [راهنمای بهترین زمان سفر به ارمنستان](/blog/best-time-to-travel-armenia) را ببینید.</p>

      <h2 class="section-title mb-4 mt-10">نکات کاربردی</h2>
      <p>بیشتر جاذبه‌های ایروان در مرکز شهر قرار دارند و با پیاده‌روی قابل دسترس هستند. برای جاذبه‌های دورتر مانند سوان و گغارد، خودرو خصوصی یا تاکسی لازم است. مترو ایروان تنها یک خط دارد و دسترسی محدودی ارائه می‌دهد. تاکسی با 应用 مانند Yandex Go و GG Taxi قابل رزرو است. ورودی بیشتر موزه‌ها بین ۱۰۰۰ تا ۳۰۰۰ درام است و عکاسی در موزه‌ها معمولاً رایگان است (بدون فلاش). برای آشنایی با زندگی شبانه ایروان، [راهنمای دیسکوها و زندگی شبانه ایروان](/travel-guide/yerevan-nightlife) را بخوانید و برای آشنایی با شهرهای دیگر، [راهنمای شهرهای ارمنستان](/travel-guide/armenia-cities) را ببینید.</p>
    </div>
  </section>

  <Faq faqs={faqs} pageUrl="/travel-guide/yerevan-attractions" />
  <Cta compact />
</Layout>
