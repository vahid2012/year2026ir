---
import '@/styles/globals.css';
import { SITE, LINKS } from '@/lib/site';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Cta from '@/components/Cta.astro';

const faLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: 'فرصت‌های شغلی در آکای تراول',
  description: 'آکای تراول آژانس گردشگری متخصص تورهای ارمنستان در حال استخدام است. راهنمای فارسی، کارشناس فروش، تولید محتوا و عملیات.',
  url: `${SITE.domain}/careers`,
  employmentType: 'FULL_TIME',
  hiringOrganization: { '@type': 'Organization', name: SITE.legalName, sameAs: SITE.domain },
};

const breadLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'خانه', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'همکاری با ما', item: `${SITE.domain}/careers` },
  ],
};

const alternates = [
  { hreflang: 'fa-IR', href: `${SITE.domain}/careers` },
  { hreflang: 'en', href: `${SITE.domain}/en/careers` },
  { hreflang: 'hy', href: `${SITE.domain}/hy/careers` },
  { hreflang: 'x-default', href: `${SITE.domain}/careers` },
];
---

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>همکاری با ما | آکای تراول</title>
  <meta name="description" content="فرصت‌های شغلی در آکای تراول؛ راهنمای تور فارسی‌زبان، کارشناس فروش، تولید محتوا و عملیات. شرایط، مزایا و نحوه درخواست." />
  <link rel="canonical" href={`${SITE.domain}/careers`} />
  {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fa_IR" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content="همکاری با ما | آکای تراول" />
  <meta property="og:description" content="فرصت‌های شغلی در آکای تراول؛ راهنمای تور، فروش، محتوا و عملیات." />
  <meta property="og:url" content={`${SITE.domain}/careers`} />
  <script type="application/ld+json" set:html={JSON.stringify(faLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadLd)} />
</head>
<body class="min-h-screen flex flex-col bg-background text-foreground">
  <header class="sticky top-0 z-40 bg-background/85 backdrop-blur-md border-b border-border">
    <div class="container-fa flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center gap-2 font-extrabold text-lg md:text-xl">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-primary text-primary-foreground">آ</span>
        <span class="text-secondary">آکای تراول</span>
      </a>
      <nav class="hidden md:flex items-center gap-1">
        <a href="/" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">خانه</a>
        <a href="/tours" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">تورها</a>
        <a href="/hotels" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">هتل‌ها</a>
        <a href="/travel-guide" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">راهنمای سفر</a>
        <a href="/careers" class="px-4 py-2 rounded-full text-sm font-semibold bg-primary text-primary-foreground">همکاری با ما</a>
        <a href="/contact" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">تماس</a>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <Breadcrumbs items={[{ name: 'خانه', path: '/' }, { name: 'همکاری با ما' }]} />

    <section class="relative overflow-hidden">
      <div class="absolute inset-0">
        <img src="https://images.pexels.com/photos/3184339/pexels-photo-3184339.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="تیم همکاران آکای تراول در جلسه کاری" width="940" height="650" class="h-full w-full object-cover" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-t from-secondary/95 via-secondary/70 to-secondary/30"></div>
      </div>
      <div class="relative container-fa py-20 md:py-28 text-white">
        <h1 class="text-3xl md:text-5xl font-extrabold mb-4 max-w-3xl">همکاری با ما</h1>
        <p class="text-lg text-white/90 max-w-2xl leading-8">به تیم آکای تراول بپیوندید؛ آژانس گردشگری متخصص تورهای ارمنستان در جستجوی افراد پرانگیزه.</p>
      </div>
    </section>

    <section class="container-fa py-10">
      <div class="prose-fa max-w-none text-muted-foreground leading-8">
        <p>آکای تراول از سال ۲۰۱۸ به عنوان متخصص تورهای ویژه ارمنستان، با تیمی کوچک اما پرانگیزه در حال رشد است. ما به دنبال افرادی هستیم که به سفر، فرهنگ ارمنستان و خدمت به مسافران ایرانی علاقه دارند و می‌خواهند در یک محیط پویا و خلاق کار کنند. اگر به دنبال شغلی فراتر از یک کار معمولی هستید و دوست دارید جزئی از تجربه‌ای باشید که مسافران ایرانی را به قلب فرهنگ ارمنی می‌برد، جای شما در تیم ما خالی است.</p>

        <h2 class="section-title mb-4 mt-10">درباره آکای تراول</h2>
        <p>آکای تراول آژانس گردشگری متخصص تورهای رویدادهای ویژه ارمنستان است. ما شش تور ویژه برای رویدادهای فرهنگی و مذهبی ارمنستان طراحی کرده‌ایم: تور کریسمس، تور ژانویه، تور هالووین، تور جشنواره بادکنک، تور وارداوار و تور مراسم خاص. دفتر مرکزی ما در ارومیه قرار دارد و تیمی از کارشناسان مجرب در زمینه تورهای ارمنستان، آماده‌ی پاسخ‌گویی به سوالات مسافران و طراحی بهترین برنامه سفر است. ما با شبکه‌ای از هتل‌ها، راهنمایان محلی و شرکای حمل‌ونقل در ایروان همکاری می‌کنیم تا سفری بی‌دردسر و پر از خاطره برای مسافران بسازیم.</p>

        <h2 class="section-title mb-4 mt-10">موقعیت‌های شغلی باز</h2>
        <p>ما در حال حاضر در جستجوی افراد پرانگیزه برای موقعیت‌های زیر هستیم:</p>

        <h3 class="font-bold text-lg mt-6 mb-2">راهنمای تور فارسی‌زبان</h3>
        <p class="text-sm">راهنمای تور همراه مسافران در سفر به ارمنستان است و مسئولیت گشت‌های شهری، بازدید از صومعه‌ها و حضور در رویدادهای فرهنگی را بر عهده دارد. تسلط به زبان فارسی و ارمنی یا روسی، آشنایی با فرهنگ و تاریخ ارمنستان، تجربه سفر به ارمنستان و توانایی مدیریت گروه ضروری است.</p>

        <h3 class="font-bold text-lg mt-6 mb-2">کارشناس فروش و رزرو</h3>
        <p class="text-sm">کارشناس فروش مسئولیت پاسخ‌گویی به مشتریان در واتساپ و تلگرام، ارائه مشاوره تور، رزرو هتل و پرواز و پیگیری فرآیند سفر را بر عهده دارد. مهارت ارتباطی قوی، آشنایی با سیستم‌های رزرو، توانایی فروش و تجربه کار در آژانس گردشگری یا فروش آنلاین ضروری است.</p>

        <h3 class="font-bold text-lg mt-6 mb-2">تولیدکننده محتوا</h3>
        <p class="text-sm">تولیدکننده محتوا مسئولیت نوشتن مقالات راهنمای سفر، محتوای شبکه‌های اجتماعی و توضیحات تورها را بر عهده دارد. مهارت نوشتاری قوی به زبان فارسی، آشنایی با سئو و شبکه‌های اجتماعی و علاقه به سفر و فرهنگ ضروری است.</p>

        <h3 class="font-bold text-lg mt-6 mb-2">کارشناس عملیات</h3>
        <p class="text-sm">کارشناس عملیات مسئولیت هماهنگی با هتل‌ها، شرکای حمل‌ونقل و راهنمایان محلی در ایروان و پیگیری اجرای تورها را بر عهده دارد. مهارت سازماندهی، توانایی حل مسئله و آشنایی با فرآیندهای گردشگری ضروری است.</p>

        <h2 class="section-title mb-4 mt-10">شرایط و الزامات</h2>
        <ul class="list-disc pr-6 space-y-2">
          <li>علاقه واقعی به سفر، فرهنگ ارمنستان و خدمت به مشتری</li>
          <li>توانایی کار تیمی و ارتباط موثر</li>
          <li>آشنایی با زبان انگلیسی یا ارمنی برای موقعیت‌های راهنما و عملیات</li>
          <li>تجربه سفر به ارمنستان برای موقعیت راهنمای تور</li>
          <li>توانایی کار با نرم‌افزارهای آفیس و شبکه‌های اجتماعی</li>
          <li>ساکن ارومیه یا آماده به سفر به ارومیه</li>
        </ul>

        <h2 class="section-title mb-4 mt-10">مزایای همکاری</h2>
        <ul class="list-disc pr-6 space-y-2">
          <li>حقوق پایه به علاوه پورسانت فروش</li>
          <li>سفر رایگان به ارمنستان در تورهای ویژه</li>
          <li>محیط کاری پویا و خلاق</li>
          <li>فرصت رشد و ارتقاء در یک شرکت در حال رشد</li>
          <li>ساعات کار منعطلف</li>
          <li>بیمه تامین اجتماعی</li>
        </ul>

        <h2 class="section-title mb-4 mt-10">نحوه درخواست</h2>
        <p>برای درخواست همکاری، رزومه خود را به یکی از راه‌های زیر ارسال کنید:</p>
        <div class="flex flex-wrap gap-3 my-4">
          <a href={LINKS.whatsapp} target="_blank" rel="noopener" class="btn-primary-fa">ارسال رزومه در واتساپ</a>
          <a href={LINKS.email} class="btn-secondary-fa">ایمیل: sanat.abr@gmail.com</a>
        </div>
        <p>لطفاً در پیام خود موقعیت شغلی موردنظر را ذکر کنید و رزومه یا شرح مختصری از تجربه خود را ارسال کنید. ما در کوتاه‌ترین زمان با شما تماس می‌گیریم. برای آشنایی بیشتر با خدمات ما، [درباره آکای تراول](/about) را بخوانید و برای [تماس مستقیم](/contact) با ما در ارتباط باشید.</p>

        <p class="mt-6">
          <a href="/careers" class="link-fa font-bold">فارسی</a> ·
          <a href="/en/careers" class="link-fa">English</a> ·
          <a href="/hy/careers" class="link-fa">Հայերեն</a>
        </p>
      </div>
    </section>

    <Cta compact />
  </main>

  <footer class="bg-secondary text-secondary-foreground mt-16">
    <div class="container-fa py-6 text-xs text-secondary-foreground/70 flex flex-col md:flex-row items-center justify-between gap-2">
      <p>© {new Date().getFullYear()} {SITE.legalName}. تمامی حقوق محفوظ است.</p>
      <p>آکای تراول - متخصص تورهای ارمنستان</p>
    </div>
  </footer>

  <div class="fixed bottom-5 right-5 z-50 flex flex-col gap-3">
    <a href={LINKS.whatsapp} target="_blank" rel="noopener" aria-label="گفتگو در واتساپ" class="group inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl transition-transform hover:scale-110">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
    </a>
  </div>
</body>
</html>
