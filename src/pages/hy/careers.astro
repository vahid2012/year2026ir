---
import '@/styles/globals.css';
import { SITE, LINKS } from '@/lib/site';

const jobLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: 'Աշխատանքային հնարավորություններ Akay Travel-ում',
  description: 'Akay Travel ճամփորդական գործակալությունը, որը մասնագիտացած է Հայաստանի տուրերում, աշխատանքի է հրավիրում: Տուրի ուղեկցորդ, վաճառք, բովանդակություն և գործառնություններ:',
  url: `${SITE.domain}/hy/careers`,
  employmentType: 'FULL_TIME',
  hiringOrganization: { '@type': 'Organization', name: SITE.brand, sameAs: SITE.domain },
};

const breadLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Գլխավոր', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'Աշխատանք', item: `${SITE.domain}/hy/careers` },
  ],
};

const alternates = [
  { hreflang: 'fa-IR', href: `${SITE.domain}/careers` },
  { hreflang: 'en', href: `${SITE.domain}/en/careers` },
  { hreflang: 'hy', href: `${SITE.domain}/hy/careers` },
  { hreflang: 'x-default', href: `${SITE.domain}/careers` },
];
---

<!doctype html>
<html lang="hy" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>Աշխատանք | Akay Travel</title>
  <meta name="description" content="Աշխատանքային հնարավորություններ Akay Travel-ում՝ տուրի ուղեկցորդ, վաճառքի մասնագետ, բովանդակության ստեղծող և գործառնությունների մասնագետ: Պահանջներ, արտոնություններ և դիմելու կարգ:" />
  <link rel="canonical" href={`${SITE.domain}/hy/careers`} />
  {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="hy_AM" />
  <meta property="og:site_name" content={SITE.brand} />
  <meta property="og:title" content="Աշխատանք | Akay Travel" />
  <meta property="og:description" content="Աշխատանքային հնարավորություններ Akay Travel-ում՝ տուրի ուղեկցորդ, վաճառք, բովանդակություն և գործառնություններ:" />
  <meta property="og:url" content={`${SITE.domain}/hy/careers`} />
  <script type="application/ld+json" set:html={JSON.stringify(jobLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadLd)} />
</head>
<body class="min-h-screen flex flex-col bg-background text-foreground">
  <header class="sticky top-0 z-40 bg-background/85 backdrop-blur-md border-b border-border">
    <div class="container-fa flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center gap-2 font-extrabold text-lg md:text-xl">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-primary text-primary-foreground">A</span>
        <span class="text-secondary">Akay Travel</span>
      </a>
      <nav class="hidden md:flex items-center gap-1">
        <a href="/" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">Գլխավոր</a>
        <a href="/tours" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">Տուրեր</a>
        <a href="/hotels" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">Հյուրանոցներ</a>
        <a href="/travel-guide" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">Ուղեցույց</a>
        <a href="/hy/careers" class="px-4 py-2 rounded-full text-sm font-semibold bg-primary text-primary-foreground">Աշխատանք</a>
        <a href="/contact" class="px-4 py-2 rounded-full text-sm font-semibold text-foreground/80 hover:text-primary hover:bg-muted">Կապ</a>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <nav class="container-fa pt-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        <li class="flex items-center gap-2"><a href="/" class="hover:text-primary transition-colors">Գլխավոր</a><span class="opacity-50">/</span></li>
        <li class="text-foreground font-semibold">Աշխատանք</li>
      </ol>
    </nav>

    <section class="relative overflow-hidden">
      <div class="absolute inset-0">
        <img src="https://images.pexels.com/photos/3184339/pexels-photo-3184339.jpeg?auto=compress&cs=tinysrgb&h=650&w=940" alt="Akay Travel թիմը բիզնես հանդիպման ժամանակ" width="940" height="650" class="h-full w-full object-cover" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-t from-secondary/95 via-secondary/70 to-secondary/30"></div>
      </div>
      <div class="relative container-fa py-20 md:py-28 text-white">
        <h1 class="text-3xl md:text-5xl font-extrabold mb-4 max-w-3xl">Աշխատանք Akay Travel-ում</h1>
        <p class="text-lg text-white/90 max-w-2xl leading-8">Միացեք Akay Travel թիմին՝ Հայաստանի տուրերի մասնագետ ճամփորդական գործակալությանը, որը փնտրում է եռանդուն և մոտիվացված անձինք:</p>
      </div>
    </section>

    <section class="container-fa py-10">
      <div class="prose-fa max-w-none text-muted-foreground leading-8">
        <p>Akay Travel-ը 2018 թվականից որպես Հայաստանի հատուկ տուրերի մասնագետ, աճում է փոքր բայց եռանդուն թիմով: Մենք փնտրում ենք այնպիսի անձինք, ովքեր սիրում են ճամփորդությունը, հայկական մշակույթը և իրանցի ճամփորդողներին ծառայելը, և ուզում են աշխատել դինամիկ և ստեղծագործ միջավայրում: Եթե դուք փնտրում եք սովորականից ավել աշխատանք և կցանկանաք լինել այն փորձառության մի մասը, որը իրանցի ճամփորդողներին բերում է հայկական մշակույթի սրտին, ձեր տեղը մեր թիմում սպասում է:</p>

        <h2 class="section-title mb-4 mt-10">Akay Travel-ի մասին</h2>
        <p>Akay Travel-ը ճամփորդական գործակալություն է, որը մասնագիտացած է Հայաստանի հատուկ միջոցառումային տուրերում: Մենք նախագծել ենք վեց հատուկ տուր Հայաստանի մշակութային և կրոնական միջոցառումների համար՝ Սուրբ Ծնունդ, Հունվար, Սամհայն, Օդապարիկների փառատոն, Վարդավառ և Հատուկ արարողություններ: Մեր գլխավոր գրասենյակը գտնվում է Ուրմիա քաղաքում, Իրան, և մեր փորձառու թիմը պատրաստ է պատասխանել ճամփորդողների հարցերին և նախագծել լավագույն ճամփորդական ծրագրեր: Մենք համագործակցում ենք հյուրանոցների, տեղական ուղեկցորդների և տրանսպորտային գործընկերների հետ Երևանում՝ ստեղծելու անխափան և հիշարժան ճամփորդություններ:</p>

        <h2 class="section-title mb-4 mt-10">Բաց թափուր պաշտոններ</h2>
        <p>Մենք ներկայումս փնտրում ենք եռանդուն անձինք հետևյալ պաշտոնների համար՝</p>

        <h3 class="font-bold text-lg mt-6 mb-2">Պարսկերեն տուրի ուղեկցորդ</h3>
        <p class="text-sm">Տուրի ուղեկցորդը ուղեկցում է ճամփորդողներին Հայաստան ճամփորդելիս՝ պատասխանատու լինելով քաղաքային տուրերի, վանքերի այցելությունների և մշակութային միջոցառումներին մասնակցելու համար: Պարսկերենի և հայերենի կամ ռուսերենի իմացությունը, հայկական մշակույթի և պատմության ծանոթությունը, Հայաստան ճամփորդելու փորձը և խմբի կառավարման կարողությունը էական են:</p>

        <h3 class="font-bold text-lg mt-6 mb-2">Վաճառքի և ամրագրման մասնագետ</h3>
        <p class="text-sm">Վաճառքի մասնագետը պատասխանատու է հաճախորդներին WhatsApp-ով և Telegram-ով պատասխանելու, տուրերի խորհրդատվություն տալու, հյուրանոցներ և չվերթներ ամրագրելու և ճամփորդության գործընթացը հետևելու համար: Ուժեղ հաղորդակցման հմտությունները, ամրագրման համակարգերի ծանոթությունը, վաճառքի ունակությունը և ճամփորդական գործակալությունում կամ առցանց վաճառքում փորձը էական են:</p>

        <h3 class="font-bold text-lg mt-6 mb-2">Բովանդակության ստեղծող</h3>
        <p class="text-sm">Բովանդակության ստեղծողը պատասխանատու է ճամփորդական ուղեցույցի հոդվածներ, սոցիալական մեդիայի բովանդակություն և տուրերի նկարագրություններ գրելու համար: Պարսկերենով ուժեղ գրելու հմտությունները, SEO-ի և սոցիալական մեդիայի ծանոթությունը և ճամփորդության ու մշակույթի հանդեպ սերը էական են:</p>

        <h3 class="font-bold text-lg mt-6 mb-2">Գործառնությունների մասնագետ</h3>
        <p class="text-sm">Գործառնությունների մասնագետը պատասխանատու է հյուրանոցների, տրանսպորտային գործընկերների և տեղական ուղեկցորդների հետ Երևանում համակարգելու և տուրերի իրականացումը հետևելու համար: Կազմակերպչական հմտությունները, խնդիրների լուծման ունակությունը և զբոսաշրջության գործընթացների ծանոթությունը էական են:</p>

        <h2 class="section-title mb-4 mt-10">Պահանջներ</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li>Ճամփորդության, հայկական մշակույթի և հաճախորդներին ծառայելու իրական հետաքրքրություն</li>
          <li>Թիմում աշխատելու և արդյունավետ հաղորդակցվելու ունակություն</li>
          <li>Անգլերենի կամ հայերենի իմացություն ուղեկցորդի և գործառնությունների պաշտոնների համար</li>
          <li>Հայաստան ճամփորդելու փորձ տուրի ուղեկցորդի պաշտոնի համար</li>
          <li>Գրասենյակային ծրագրերի և սոցիալական մեդիայի իմացություն</li>
          <li>Ուրմիայի բնակիչ կամ Ուրմիա տեղափոխվելու պատրաստակամություն</li>
        </ul>

        <h2 class="section-title mb-4 mt-10">Արտոնություններ</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li>Հիմնական աշխատավարձ գումարած վաճառքի պրոցենտ</li>
          <li>Անվճար ճամփորդություն Հայաստան հատուկ տուրերում</li>
          <li>Դինամիկ և ստեղծագործ աշխատանքային միջավայր</li>
          <li>Աճի և առաջխաղացման հնարավորություններ աճող ընկերությունում</li>
          <li>Ճկուն աշխատանքային ժամեր</li>
          <li>Սոցիալական ապահովագրություն</li>
        </ul>

        <h2 class="section-title mb-4 mt-10">Ինչպես դիմել</h2>
        <p>Դիմելու համար ուղարկեք ձեր ռեզյումեն հետևյալ մեթոդներից մեկով՝</p>
        <div class="flex flex-wrap gap-3 my-4">
          <a href={LINKS.whatsapp} target="_blank" rel="noopener" class="btn-primary-fa">Ուղարկել ռեզյումեն WhatsApp-ով</a>
          <a href={LINKS.email} class="btn-secondary-fa">Էլ. փոստ՝ sanat.abr@gmail.com</a>
        </div>
        <p>Խնդրում ենք նշել պաշտոնը, որին դիմում եք, և ուղարկել ձեր ռեզյումեն կամ ձեր փորձի կարճ նկարագիրը: Մենք հնարավորինս շուտ կանդրադառնանք ձեզ: Մեր մասին ավելին իմանալու համար կարդացեք մեր <a href="/about" class="link-fa">Մեր մասին</a> էջը և կապվեք մեզ հետ <a href="/contact" class="link-fa">Կապ</a> էջի միջոցով:</p>

        <p class="mt-6">
          <a href="/careers" class="link-fa">فارسی</a> ·
          <a href="/en/careers" class="link-fa">English</a>
        </p>
      </div>
    </section>

    <section class="cta-fa my-8">
      <div class="container-fa">
        <div class="rounded-3xl bg-gradient-to-br from-primary to-accent text-primary-foreground px-6 py-10 text-center shadow-xl">
          <h2 class="text-2xl font-extrabold mb-3">Պատրա՞ստ եք միանալու:</h2>
