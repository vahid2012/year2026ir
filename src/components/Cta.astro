---
import { LINKS, SITE } from '@/lib/site';
export interface Props {
  title?: string;
  compact?: boolean;
}
const { title = 'آیا آماده سفر هستید؟', compact = false } = Astro.props;
---

<section class={`cta-fa ${compact ? 'my-8' : 'my-14'}`}>
  <div class="container-fa">
    <div class="rounded-3xl bg-gradient-to-br from-primary to-accent text-primary-foreground px-6 py-10 md:py-12 text-center shadow-xl">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-3">{title}</h2>
      <p class="max-w-2xl mx-auto text-primary-foreground/90 mb-6 leading-8">
        همین حالا با کارشناسان آکای تراول تماس بگیرید تا بهترین تور رویدادهای ویژه ارمنستان را برای شما رزرو کنیم.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href={LINKS.whatsapp} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-white text-primary px-6 py-3 font-bold hover:scale-105 transition-transform shadow">
          رزرو در واتساپ (0{SITE.mobile})
        </a>
        <a href={LINKS.telegram} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-secondary text-secondary-foreground px-6 py-3 font-bold hover:scale-105 transition-transform shadow">
          گفتگو در تلگرام
        </a>
        <a href={LINKS.phoneCall} class="inline-flex items-center gap-2 rounded-full border-2 border-white px-6 py-3 font-bold hover:bg-white/10 transition-colors" dir="ltr">
          {SITE.phone}
        </a>
      </div>
    </div>
  </div>
</section>
