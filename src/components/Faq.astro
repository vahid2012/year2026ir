---
import { SITE } from '@/lib/site';
export interface Props {
  faqs: { q: string; a: string }[];
  pageUrl: string;
}
const { faqs, pageUrl } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: new URL(pageUrl, SITE.domain).href,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="container-fa my-12">
  <h2 class="section-title mb-6">پرسش‌های پرتکرار</h2>
  <div class="space-y-3">
    {
      faqs.map((f, i) => (
        <details class="card-fa p-5 group" open={i === 0}>
          <summary class="flex cursor-pointer items-center justify-between font-bold text-foreground">
            <span>{f.q}</span>
            <span class="text-primary text-xl transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-muted-foreground leading-8">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
