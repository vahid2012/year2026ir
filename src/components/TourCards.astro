---
import { TOURS, BLOGS } from '@/lib/site';

export interface Props {
  currentSlug?: string;
  limit?: number;
}
const { currentSlug, limit } = Astro.props;
let list = TOURS.filter((t) => t.slug !== currentSlug);
if (limit) list = list.slice(0, limit);
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    list.map((t) => (
      <a href={`/tours/${t.slug}`} class="card-fa overflow-hidden group block">
        <div class="aspect-[16/10] overflow-hidden">
          <img
            src={t.image}
            alt={t.imageAlt}
            width="940"
            height="650"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
        <div class="p-5">
          <div class="flex items-center gap-2 text-xs text-muted-foreground mb-2">
            <span class="rounded-full bg-accent/15 text-accent-foreground px-2 py-1 font-semibold">{t.season}</span>
            <span>{t.duration}</span>
          </div>
          <h3 class="font-bold text-lg mb-2 group-hover:text-primary transition-colors">{t.title}</h3>
          <p class="text-sm text-muted-foreground leading-7 line-clamp-3">{t.excerpt}</p>
          <span class="mt-4 inline-block text-sm font-bold text-primary">مشاهده تور ←</span>
        </div>
      </a>
    ))
  }
</div>
