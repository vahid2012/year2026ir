---
import { NAV, SITE, LINKS } from '@/lib/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-40 bg-background/85 backdrop-blur-md border-b border-border">
  <div class="container-fa flex items-center justify-between h-16 md:h-20">
    <a href="/" class="flex items-center gap-2 font-extrabold text-lg md:text-xl">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-primary text-primary-foreground">آ</span>
      <span class="text-secondary">{SITE.name}</span>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class={`px-4 py-2 rounded-full text-sm font-semibold transition-colors ${
              isActive(item.href)
                ? 'bg-primary text-primary-foreground'
                : 'text-foreground/80 hover:text-primary hover:bg-muted'
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={LINKS.whatsapp}
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex btn-primary-fa !py-2 !px-4 text-xs"
      >
        رزرو تور
      </a>
      <button id="menu-toggle" class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-full bg-muted text-foreground" aria-label="منو">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-border bg-background">
    <nav class="container-fa flex flex-col py-3">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class={`px-3 py-3 rounded-lg text-sm font-semibold ${
              isActive(item.href) ? 'bg-primary text-primary-foreground' : 'hover:bg-muted'
            }`}
          >
            {item.label}
          </a>
        ))
      }
      <a href={LINKS.whatsapp} target="_blank" rel="noopener" class="btn-primary-fa mt-3">رزرو تور در واتساپ</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
